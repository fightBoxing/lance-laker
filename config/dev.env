# ============================================================
# LCP 本地开发环境配置 (all-in-one)
# ============================================================
# 用法:
#   cp config/dev.env .env
#   lcp-server --insecure
#
# 或加载多个文件:
#   source config/server.env config/database.env config/storage.env
# ============================================================

# --- App ---
LCP_APP_NAME=lcp
LCP_APP_ENV=dev

# --- REST + gRPC ---
LCP_REST_HOST=127.0.0.1
LCP_REST_PORT=8080
LCP_GRPC_HOST=127.0.0.1
LCP_GRPC_PORT=50051

# --- 认证 (开发环境宽松) ---
LCP_OIDC_ISSUER=https://idp.example.com
LCP_OIDC_AUDIENCE=lcp-api
LCP_MTLS_REQUIRE_CLIENT_CERT=false
LCP_ENFORCE_TENANT_RLS=false

# --- 数据库 (本地 Docker MySQL) ---
LCP_DB_DSN=mysql+aiomysql://lcp:lcp_dev_pwd@127.0.0.1:3306/lcp
LCP_DB_POOL_SIZE=5
LCP_DB_MAX_OVERFLOW=10
LCP_DB_POOL_RECYCLE_SECONDS=3600

# --- 对象存储 (本地 MinIO) ---
LCP_LANCE_STORAGE_ENDPOINT=http://127.0.0.1:9000
LCP_LANCE_STORAGE_ACCESS_KEY=minioadmin
LCP_LANCE_STORAGE_SECRET_KEY=minioadmin
LCP_LANCE_STORAGE_REGION=us-east-1
LCP_LANCE_STORAGE_ALLOW_HTTP=true
LCP_LANCE_STORAGE_PATH_STYLE=true

# --- Gravitino (默认禁用) ---
LCP_GRAVITINO_URL=
LCP_GRAVITINO_METALAKE=default
LCP_GRAVITINO_CATALOG=lance

# --- Embedding (本地 Ollama 示例) ---
LCP_EMBEDDING_DEFAULT_ENDPOINT=http://127.0.0.1:11434/api/embeddings
LCP_EMBEDDING_API_KEY=
LCP_EMBEDDING_API_KEY_HEADER=Authorization
LCP_EMBEDDING_REQUEST_TIMEOUT_SECONDS=30
