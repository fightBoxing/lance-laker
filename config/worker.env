# ============================================================
# LCP Worker 配置 (任务执行 + 心跳 + Planner)
# ============================================================
# 部署: lcp-worker Deployment
# 入口: python -m lcp.workers.lifecycle_worker
# 功能: 抢占式任务执行, 周期心跳, 内嵌 Planner
# ============================================================

# --- Worker 运行参数 ---
# 任务类型过滤 (空=接收所有类型; 可设为 TTL_DELETE/COMPACTION/INDEX_BUILD/INDEX_OPTIMIZE/VECTORIZE)
# LCP_WORKER_TASK_TYPE=

# 空闲 sleep (无任务时等待间隔, 秒)
# LCP_WORKER_IDLE_SECONDS=2

# 忙碌 sleep (成功消费任务后, 下次拉取前等待, 秒)
# LCP_WORKER_BUSY_SECONDS=0.1

# 心跳间隔 (秒, 建议 < heartbeat_timeout/3)
# LCP_WORKER_HEARTBEAT_SECONDS=10

# --- Planner (内嵌调度) ---
# Planner 扫描间隔 (秒, 0 或 disable-planner 标志可关闭)
# LCP_WORKER_PLANNER_SECONDS=60

# --- 多租户 RLS ---
# Worker 进程同样加载 RLS hook, 但以 system principal 运行 (bypass)
LCP_ENFORCE_TENANT_RLS=true
