# ============================================================
# 数据库配置 (MySQL / SQLAlchemy async)
# ============================================================
# 共享: lcp-server + lcp-worker 均使用
# 格式: SQLAlchemy async DSN
# ============================================================

# --- 连接 ---
# 格式: mysql+aiomysql://user:password@host:port/database
LCP_DB_DSN=mysql+aiomysql://lcp:lcp@127.0.0.1:3306/lcp

# --- 连接池 ---
# 基础池大小 (常驻连接数)
LCP_DB_POOL_SIZE=10

# 允许的额外溢出连接 (突发流量时临时扩展, 总最大 = pool_size + max_overflow)
LCP_DB_MAX_OVERFLOW=20

# 连接回收周期 (秒, 防止 MySQL wait_timeout 断连)
LCP_DB_POOL_RECYCLE_SECONDS=3600
