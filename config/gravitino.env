# ============================================================
# Gravitino 元数据集成配置
# ============================================================
# 用途: 从 Gravitino catalog 发现 LanceDB 表并同步到 LCP
# 使用者: lcp-server (meta sync 端点)
# 禁用方式: 留空 LCP_GRAVITINO_URL
# ============================================================

# --- 连接 ---
# Gravitino REST API 地址 (空=禁用集成, /meta/sync 返回 503)
LCP_GRAVITINO_URL=

# metalake 名称 (Gravitino 逻辑命名空间)
LCP_GRAVITINO_METALAKE=default

# catalog 名称 (metalake 下存放 LanceDB filesets 的 catalog)
LCP_GRAVITINO_CATALOG=lance

# --- 认证 ---
# Bearer token (空=无认证)
LCP_GRAVITINO_AUTH_TOKEN=

# --- 超时 ---
# HTTP 请求超时 (秒)
LCP_GRAVITINO_TIMEOUT_SECONDS=10
