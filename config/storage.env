# ============================================================
# 对象存储配置 (MinIO / S3 — Lance 数据面)
# ============================================================
# 共享: lcp-server (读) + lcp-worker (读写)
# 用途: lance dataset 的持久化存储后端
# ============================================================

# --- S3 兼容对象存储 ---
# Endpoint URL (空=使用本地文件系统/pyarrow 默认 S3)
LCP_LANCE_STORAGE_ENDPOINT=http://minio:9000

# 凭证
LCP_LANCE_STORAGE_ACCESS_KEY=minioadmin
LCP_LANCE_STORAGE_SECRET_KEY=minioadmin

# 区域
LCP_LANCE_STORAGE_REGION=us-east-1

# 是否允许 HTTP (非 TLS) — 开发环境 MinIO 用 true, 生产建议 false
LCP_LANCE_STORAGE_ALLOW_HTTP=true

# 是否使用路径风格 (path-style) 请求
# MinIO = true (不支持虚拟主机子域名)
# AWS S3 = false (推荐虚拟主机)
LCP_LANCE_STORAGE_PATH_STYLE=true
