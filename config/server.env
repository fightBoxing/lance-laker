# ============================================================
# LCP Server 配置 (REST API + gRPC)
# ============================================================
# 部署: lcp-server Deployment
# 入口: lcp-server (unified_server.py)
# 端口: REST :8080, gRPC :50051
# ============================================================

# --- 应用元信息 ---
LCP_APP_NAME=lcp
LCP_APP_ENV=dev

# --- REST 服务 ---
LCP_REST_HOST=0.0.0.0
LCP_REST_PORT=8080

# --- gRPC 服务 ---
LCP_GRPC_HOST=0.0.0.0
LCP_GRPC_PORT=50051

# --- OIDC / OAuth2 认证 ---
# OIDC issuer URL, 用于 .well-known/openid-configuration 发现
LCP_OIDC_ISSUER=https://idp.example.com
# JWT audience 校验值
LCP_OIDC_AUDIENCE=lcp-api
# JWKs 缓存 TTL (秒)
LCP_OIDC_JWKS_CACHE_TTL_SECONDS=3600
# 允许的签名算法 (逗号分隔, 仅公钥族, 防 alg=HS256 攻击)
LCP_OIDC_ALLOWED_ALGORITHMS=RS256,RS384,RS512,ES256,ES384
# 时钟偏移容忍 (秒)
LCP_OIDC_CLOCK_SKEW_LEEWAY_SECONDS=30

# --- mTLS (gRPC 东西向通信) ---
LCP_MTLS_SERVER_CERT_PATH=/etc/lcp/tls/server.crt
LCP_MTLS_SERVER_KEY_PATH=/etc/lcp/tls/server.key
LCP_MTLS_CA_CERT_PATH=/etc/lcp/tls/ca.crt
# 是否要求客户端证书 (生产=true, 开发=false)
LCP_MTLS_REQUIRE_CLIENT_CERT=true

# --- 多租户 RLS ---
# 是否启用 App-layer 行级安全 (关闭仅用于本地 smoke 测试)
LCP_ENFORCE_TENANT_RLS=true
