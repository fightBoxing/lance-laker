# ============================================================
# LCP K8s 集群部署配置
# ============================================================
# 用法:
#   kubectl create configmap lcp-config --from-env-file=config/k8s.env -n lcp
#   或直接体现在 deploy/k8s/00-namespace-config.yaml 的 ConfigMap data 段
# ============================================================

# --- App ---
LCP_APP_NAME=lcp
LCP_APP_ENV=production

# --- REST + gRPC (K8s Pod 内绑定所有接口) ---
LCP_REST_HOST=0.0.0.0
LCP_REST_PORT=8080
LCP_GRPC_HOST=0.0.0.0
LCP_GRPC_PORT=50051

# --- 认证 (生产开启) ---
LCP_OIDC_ISSUER=https://idp.yourcompany.com
LCP_OIDC_AUDIENCE=lcp-api
LCP_OIDC_JWKS_CACHE_TTL_SECONDS=3600
LCP_OIDC_CLOCK_SKEW_LEEWAY_SECONDS=30
LCP_MTLS_REQUIRE_CLIENT_CERT=true
LCP_MTLS_SERVER_CERT_PATH=/etc/lcp/tls/server.crt
LCP_MTLS_SERVER_KEY_PATH=/etc/lcp/tls/server.key
LCP_MTLS_CA_CERT_PATH=/etc/lcp/tls/ca.crt
LCP_ENFORCE_TENANT_RLS=true

# --- 数据库 ---
LCP_DB_DSN=mysql+aiomysql://lcp:${DB_PASSWORD}@mysql.lcp.svc.cluster.local:3306/lcp
LCP_DB_POOL_SIZE=10
LCP_DB_MAX_OVERFLOW=20
LCP_DB_POOL_RECYCLE_SECONDS=3600

# --- 对象存储 ---
LCP_LANCE_STORAGE_ENDPOINT=http://minio.storage.svc.cluster.local:9000
LCP_LANCE_STORAGE_ACCESS_KEY=${MINIO_ACCESS_KEY}
LCP_LANCE_STORAGE_SECRET_KEY=${MINIO_SECRET_KEY}
LCP_LANCE_STORAGE_REGION=us-east-1
LCP_LANCE_STORAGE_ALLOW_HTTP=true
LCP_LANCE_STORAGE_PATH_STYLE=true

# --- Gravitino ---
LCP_GRAVITINO_URL=http://gravitino.gravitino.svc.cluster.local:8090
LCP_GRAVITINO_METALAKE=default
LCP_GRAVITINO_CATALOG=lance
LCP_GRAVITINO_AUTH_TOKEN=
LCP_GRAVITINO_TIMEOUT_SECONDS=10

# --- Embedding ---
LCP_EMBEDDING_DEFAULT_ENDPOINT=http://embedding-svc.ai.svc.cluster.local:8000/v1/embeddings
LCP_EMBEDDING_API_KEY=${EMBEDDING_API_KEY}
LCP_EMBEDDING_API_KEY_HEADER=Authorization
LCP_EMBEDDING_REQUEST_TIMEOUT_SECONDS=60
