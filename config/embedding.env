# ============================================================
# Embedding 向量化服务配置
# ============================================================
# 用途: VECTORIZE executor 调用第三方/自建 Embedding 模型
# 使用者: lcp-worker (VectorizationExecutor)
# ============================================================

# --- 模型端点 ---
# 默认 Embedding 模型 HTTP 端点 (OpenAI 兼容格式)
# 示例:
#   OpenAI:       https://api.openai.com/v1/embeddings
#   Azure OpenAI: https://<resource>.openai.azure.com/openai/deployments/<model>/embeddings?api-version=2024-02-01
#   Cohere:       https://api.cohere.ai/v1/embed
#   vLLM:         http://vllm-svc:8000/v1/embeddings
#   TEI:          http://tei-svc:8080/embed
#   Ollama:       http://ollama:11434/api/embeddings
#   通义千问:     https://dashscope.aliyuncs.com/api/v1/services/embeddings/text-embedding/text-embedding
#   智谱 AI:     https://open.bigmodel.cn/api/paas/v4/embeddings
#
# 空 = 禁用向量化 (除非 VectorizationRule 里单独指定 model_endpoint)
LCP_EMBEDDING_DEFAULT_ENDPOINT=

# --- 认证 ---
# 全局默认 API Key (各规则可通过 extra.api_key 独立覆盖)
# 留空 = 无认证 (适用于自建无鉴权的模型服务)
LCP_EMBEDDING_API_KEY=

# API Key 传递的 HTTP Header 名称:
#   Authorization  — OpenAI/兼容服务 (发送 "Bearer <key>")
#   X-Api-Key      — Cohere
#   Api-Key        — Azure OpenAI
#   X-DashScope-ApiKey — 通义千问
#
# 默认: Authorization
LCP_EMBEDDING_API_KEY_HEADER=Authorization

# --- 超时 ---
# 单次 HTTP 请求超时 (秒, 大 batch 可能需要更长)
LCP_EMBEDDING_REQUEST_TIMEOUT_SECONDS=30

# ============================================================
# 每条 VectorizationRule 可通过 extra JSON 字段覆盖全局配置:
#
#   {
#     "api_key": "sk-per-rule-key-xxx",
#     "api_key_header": "Authorization"
#   }
#
# 优先级: rule.extra.api_key > LCP_EMBEDDING_API_KEY (全局)
# ============================================================
